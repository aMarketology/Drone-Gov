# Auto detect text files and perform LF normalization
* text=auto

# Video and audio are hosted externally (Vimeo/YouTube) and must never be
# committed. This repo is on the free GitHub LFS tier, and large media in
# history exhausts it permanently. .gitignore also excludes public/new/*.
*.mp4 -text -diff
*.MP4 -text -diff
*.mov -text -diff
*.MOV -text -diff
*.wav -text -diff
*.WAV -text -diff
*.pptx -text -diff
