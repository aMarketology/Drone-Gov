# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Newsletter signups
/data/newsletter-signups.json

# Large media — hosted externally (Vimeo/YouTube), never committed.
# Small flight clips are intentionally re-included below (see .gitattributes);
# they are stored as ordinary Git objects, NOT via LFS, so they cannot
# consume the LFS quota.
/public/new/*
!/public/new/RE BR Launch.mp4
!/public/new/RE BR Landing.mp4
!/public/new/RE Item Drop.mp4
!/public/new/FWD Look Cam Drop.mp4
!/public/new/Trillium GCS Drop.MP4
/public/*.mp4
/public/*.MP4
/public/*.mov
/public/*.MOV
